POSTGRES_USER=groupsapp_developer
POSTGRES_PASSWORD=123456

DEBUG=False

DB_AUTH=auth_db
DB_GROUPS=groups_db
DB_MESSAGES=messages_db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY_AUTH=django-insecure-auth-replace-in-prod
SECRET_KEY_GROUPS=django-insecure-groups-replace-in-prod
SECRET_KEY_MESSAGES=django-insecure-messages-replace-in-prod

# DEBE ser la misma en los 3 servicios — es la clave con la que se firman y verifican los JWT
JWT_SECRET_KEY=django-insecure-jwt-shared-replace-in-prod
